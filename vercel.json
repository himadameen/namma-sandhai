{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://namma-sandhai-api.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://namma-sandhai-api.vercel.app/uploads/:path*"
    },
    {
      "source": "/((?!assets|icons|favicon\\.svg|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
